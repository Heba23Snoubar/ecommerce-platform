# ---- App database ----

APP_DB_NAME=appdb
APP_DB_USER=postgres
APP_DB_PASSWORD=change_me_app

# ---- Warehouse database ----

WAREHOUSE_DB_NAME=warehousedb
WAREHOUSE_DB_USER=postgres
WAREHOUSE_DB_PASSWORD=change_me_wh

# ---- Per-module DB passwords (must match init.sql) ----

USERS_DB_PASSWORD=users_pw
PRODUCTS_DB_PASSWORD=products_pw
ORDERS_DB_PASSWORD=orders_pw
NOTIFICATIONS_DB_PASSWORD=notifications_pw
CART_DB_PASSWORD=cart_pw

# ---- JWT ----

JWT_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=ecommerce-app
JWT_AUDIENCE=ecommerce-clients

# ---- Replication ----
REPLICATOR_PASSWORD=replicator_pw

# ---- Redis Caching (Role C) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb
REDIS_CONNECTION_STRING=localhost:6379,abortConnect=false,connectTimeout=3000
# ---- RabbitMQ ----
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me_rabbit
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# ---- SMTP (Worker) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- WebSocket server (Pusher protocol) ----
PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=change_me_pusher
PUSHER_HOST=localhost
PUSHER_PORT=6001
VITE_PUSHER_KEY=app-key
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=6001